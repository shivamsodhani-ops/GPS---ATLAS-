# Copy this file to backend/.env and fill in what you need.
# Everything here has a safe default -- GPS ATLAS runs fully offline with
# zero configuration. Only fill this in to change that behaviour.

# --- Security (set a real value before any real deployment) ----------------
# ATLAS_SECRET_KEY=replace-with-a-long-random-string

# --- First-run admin account -------------------------------------------------
# ATLAS_SEED_ADMIN_EMAIL=admin@gpsrenewables.com
# ATLAS_SEED_ADMIN_PASSWORD=ChangeMe!2026
# ATLAS_SEED_DEMO_DATA=true

# --- Optional: upgrade AI answers to a hosted model -------------------------
# Leave all of these unset to run in fully offline "extractive" mode (zero
# hallucination risk, zero cost, zero network). Set ONE of the blocks below
# to upgrade to natural-language answers. ATLAS_AI_PROVIDER_ORDER controls
# the fallback chain -- "hosted,ollama,extractive" (default) tries your key
# first, then a local Ollama server, then always falls back to extractive.

# OpenAI
# ATLAS_OPENAI_API_KEY=sk-...
# ATLAS_OPENAI_MODEL=gpt-4o-mini

# Anthropic
# ATLAS_ANTHROPIC_API_KEY=sk-ant-...
# ATLAS_ANTHROPIC_MODEL=claude-sonnet-4-5

# Azure OpenAI
# ATLAS_AZURE_OPENAI_API_KEY=...
# ATLAS_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# ATLAS_AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Local Ollama (fully offline, no cloud, no API key)
# ATLAS_OLLAMA_HOST=http://localhost:11434
# ATLAS_OLLAMA_MODEL=llama3.1

# --- CORS (only matters if you serve the frontend from a different origin) -
# ATLAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
